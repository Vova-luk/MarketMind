# Local development values. Process environment overrides this file.
MARKETMIND_SERVER__HOST=0.0.0.0
MARKETMIND_SERVER__PORT=8080
MARKETMIND_LOGGER__LEVEL=info
MARKETMIND_LOGGER__OUTPUT=stdout
MARKETMIND_LOGGER__FORMAT=json
MARKETMIND_LOGGER__FILE=logs/api.log

MARKETMIND_DATABASE__HOST=localhost
MARKETMIND_DATABASE__PORT=5432
MARKETMIND_DATABASE__USER=marketmind
MARKETMIND_DATABASE__PASSWORD=marketmind_dev
MARKETMIND_DATABASE__DATABASE=marketmind
MARKETMIND_DATABASE__SSLMODE=disable

# Set the token of the bot that opens the Mini App to enable API registration.
MARKETMIND_TELEGRAM__BOT_TOKEN=

# Enable the notifications profile to run the bot.
BOT_TOKEN=
BOT_KAFKA_WORKERS=1

MARKETMIND_DEPLOY__POSTGRES_PORT=5432
