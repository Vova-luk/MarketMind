# Public values for the local test stack and CI. Keep real credentials out of this file.
MARKETMIND_SERVER__PORT=18080
MARKETMIND_DEPLOY__POSTGRES_PORT=15432
MARKETMIND_DATABASE__USER=marketmind
MARKETMIND_DATABASE__PASSWORD=marketmind_test
MARKETMIND_DATABASE__DATABASE=marketmind_test
MARKETMIND_TELEGRAM__BOT_TOKEN=123456:integration-test
BOT_TOKEN=${MARKETMIND_TELEGRAM__BOT_TOKEN}

TEST_API_URL=http://127.0.0.1:${MARKETMIND_SERVER__PORT}
TEST_DATABASE_URL=postgres://${MARKETMIND_DATABASE__USER}:${MARKETMIND_DATABASE__PASSWORD}@127.0.0.1:${MARKETMIND_DEPLOY__POSTGRES_PORT}/${MARKETMIND_DATABASE__DATABASE}?sslmode=disable
TEST_KAFKA_BROKERS=localhost:29092,localhost:39092
TEST_TELEGRAM_STUB_PORT=18083
TEST_TELEGRAM_STUB_URL=http://127.0.0.1:${TEST_TELEGRAM_STUB_PORT}
TEST_BYBIT_STUB_PORT=18084
TEST_BYBIT_STUB_URL=http://127.0.0.1:${TEST_BYBIT_STUB_PORT}
